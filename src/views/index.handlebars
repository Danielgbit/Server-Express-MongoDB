<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lista de Productos</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-dark text-light">
    <div class="container mt-5">
      <h1 class="text-center mb-4">Lista de Productos</h1>
      {{#if products.length}}
        <div class="row">
          {{#each products}}
            <div class="col-md-4 mb-4">
              <div class="card h-100 bg-secondary text-light shadow">
                <div class="card-body">
                  <h5 class="card-title">{{title}}</h5>
                  <p class="card-text">{{description}}</p>
                  <p class="card-text"><strong>Precio:</strong> ${{price}}</p>
                  <form action="/addProductInCart/{{_id}}" method="POST">
                    <button type="submit" class="btn btn-success w-100">
                      Agregar al carrito
                    </button>
                  </form>
                </div>
              </div>
            </div>
          {{/each}}
        </div>
        <div class="d-flex justify-content-center gap-2 my-4">
          {{#if hasPrevPage}}
            <form action="/" method="GET">
              <input type="hidden" name="page" value="{{restar page 1}}" />
              <button type="submit" class="btn btn-dark">
                Previous
              </button>
            </form>
          {{/if}}
          <span class="align-self-center">Page {{page}}</span>
          {{#if hasNextPage}}
            <form action="/" method="GET">
              <input type="hidden" name="page" value="{{sumar page 1}}" />
              <button type="submit" class="btn btn-dark">
                Next
              </button>
            </form>
          {{/if}}
        </div>
      {{else}}
        <p class="text-center">No hay productos disponibles.</p>
      {{/if}}
      <div class="text-center mt-4">
        <a href="/realtimeproducts" class="btn btn-primary">
          Ver productos en tiempo real
        </a>
      </div>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
    ></script>
  </body>
</html>