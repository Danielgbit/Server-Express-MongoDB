<h2>🛒 Tu Carrito</h2>

{{#if products.length}}
    <ul>
        {{#each products}}
            <li>
                <h3>{{this.productId.title}}</h3>
                <p>Cantidad: {{this.quantity}}</p>
                <p>Precio: ${{this.productId.price}}</p>
            </li>
        {{/each}}
    </ul>
{{else}}
    <p>Tu carrito está vacío.</p>
{{/if}}
