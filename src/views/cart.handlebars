<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrito de Compras</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="container mt-5">
        <h2 class="text-center mb-4">🛒 Tu Carrito</h2>

        {{#if products.length}}
            <div class="row">
                {{#each products}}
                    <div class="col-md-6 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title">{{this.title}}</h5>
                                <p class="card-text text-muted">{{this.description}}</p>
                                <p class="card-text"><strong>Precio:</strong> ${{this.price}}</p>
                                <div class="d-flex align-items-center justify-content-between">
                                    <!-- Controles de cantidad -->
                                    <div class="d-flex align-items-center gap-2">
                                        <form action="/updateProductInCart/{{_id}}" method="POST" class="me-2">
                                            <input type="hidden" name="action" value="decrement">
                                            <button type="submit" class="btn btn-outline-secondary btn-sm" {{#if (eq quantity 1)}}disabled{{/if}}>
                                                <i class="fas fa-minus"></i>
                                            </button>
                                        </form>
                                        <span class="mx-2 fs-5">{{quantity}}</span>
                                        <form action="/updateProductInCart/{{_id}}" method="POST">
                                            <input type="hidden" name="action" value="increment">
                                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </form>
                                    </div>
                                    <!-- Botón para eliminar el producto -->
                                    <form action="/deleteProductInCart/{{_id}}" method="POST">
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash"></i> Eliminar
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                {{/each}}
            </div>

            <!-- Mostrar el total del carrito -->
            <div class="text-end mt-4">
                <h4>Total: ${{total}}</h4>
            </div>

            <!-- Botón para vaciar el carrito -->
            <div class="text-center mt-4">
                <form action="/clearCart" method="POST">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Vaciar Carrito
                    </button>
                </form>
            </div>
        {{else}}
            <p class="text-center text-muted">Tu carrito está vacío.</p>
        {{/if}}
    </div>
</body>
</html>