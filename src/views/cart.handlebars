<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrito de Compras</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h2 class="text-center mb-4">🛒 Tu Carrito</h2>

        {{#if products.length}}
            <div class="row">
                {{#each products}}
                    <div class="col-md-6 mb-4">
                        <div class="card h-100 shadow">
                            <div class="card-body">
                                <h3 class="card-title">{{this.title}}</h3>
                                <p class="card-text">{{this.description}}</p>
                                <p class="card-text"><strong>Precio:</strong> ${{this.price}}</p>
                                <div class="d-flex align-items-center">
                                    <!-- Formulario para decrementar -->
                                    <form action="/updateProductInCart/{{_id}}" method="POST" class="me-2">
                                        <input type="hidden" name="action" value="decrement"> <!-- Campo oculto para la acción -->
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">-</button>
                                    </form>

                                    <!-- Cantidad actual -->
                                    <span class="mx-2">{{quantity}}</span>

                                    <!-- Formulario para incrementar -->
                                    <form action="/updateProductInCart/{{_id}}" method="POST">
                                        <input type="hidden" name="action" value="increment"> <!-- Campo oculto para la acción -->
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">+</button>
                                    </form>
                                </div>
                                <!-- Botón para eliminar el producto -->
                                    <form action="/deleteProductInCart/{{_id}}" method="POST">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">ELIMINAR</button>
                                    </form>
                            </div>
                        </div>
                    </div>
                {{/each}}
            </div>
        {{else}}
            <p class="text-center">Tu carrito está vacío.</p>
        {{/if}}
    </div>